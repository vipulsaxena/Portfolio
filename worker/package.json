{
  "name": "portfolio-chat-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute portfolio-chat --remote --file=schema.sql",
    "db:migrate:local": "wrangler d1 execute portfolio-chat --local --file=schema.sql",
    "db:migrate:read": "wrangler d1 execute portfolio-chat --remote --file=migrations/001_read_at.sql",
    "db:migrate:read:local": "wrangler d1 execute portfolio-chat --local --file=migrations/001_read_at.sql",
    "test:sync": "node scripts/test-chat-sync.mjs",
    "test:knowledge": "node scripts/test-chat-knowledge.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250204.0",
    "typescript": "^5.7.3",
    "wrangler": "^3.109.1"
  }
}
